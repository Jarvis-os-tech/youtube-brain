[Unit]
Description=yt-brain YouTube pipeline (batch, runs on boot)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/jarvis-yt-brain/yt_brain
ExecStart=%h/jarvis-yt-brain/yt_brain/run_pipeline.sh
Nice=10
CPUWeight=20
IOWeight=20
TimeoutStartSec=4h
KillSignal=SIGINT
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/jarvis-yt-brain
ReadWritePaths=-%h/.local/share/jarvis/shared_memory/vault
ReadWritePaths=-%h/Documents/JARVIS\ Memory
ReadWritePaths=-%h/.local/state/opencode
ReadWritePaths=-%h/.config/opencode
Environment=TMPDIR=%h/jarvis-yt-brain/tmp
Environment=JARVIS_BUS_SOCKET=%h/jarvis-yt-brain/run/agent_bus.sock
Environment=XDG_DATA_HOME=%h/jarvis-yt-brain/opencode-data
Environment=XDG_CACHE_HOME=%h/jarvis-yt-brain/opencode-cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
