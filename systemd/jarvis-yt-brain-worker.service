[Unit]
Description=Jarvis yt-brain worker (KB search + pipeline control)
After=network.target jarvis-agent-bus.service
Wants=jarvis-agent-bus.service

[Service]
Type=simple
WorkingDirectory=%h/jarvis-yt-brain/yt_brain
ExecStart=%h/jarvis-yt-brain/yt_brain/.venv/bin/python %h/jarvis-yt-brain/yt_brain/jarvis_yt_brain_worker.py
Restart=on-failure
RestartSec=5
RestartForceExitStatus=143

NoNewPrivileges=yes
PrivateTmp=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/jarvis-yt-brain
Environment=TMPDIR=%h/jarvis-yt-brain/tmp
Environment=JARVIS_BUS_SOCKET=%h/jarvis-yt-brain/run/agent_bus.sock
Environment=XDG_DATA_HOME=%h/jarvis-yt-brain/opencode-data
Environment=XDG_CACHE_HOME=%h/jarvis-yt-brain/opencode-cache
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
